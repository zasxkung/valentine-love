
 //@version=6
indicator("XAUUSD RSI + MFI MTF Peak, Divergence & Volume Profile", overlay=true, max_labels_count=300, max_lines_count=100, max_boxes_count=100)

//====================================================
// 1. INPUTS
//====================================================
string GRP_MTF = "1. RSI + MFI MTF"
int rsiLen = input.int(14, "RSI Length", minval=2, group=GRP_MTF)
int mfiLen = input.int(14, "MFI Length", minval=2, group=GRP_MTF)
int leftBars = input.int(3, "Pivot Left", minval=1, group=GRP_MTF)
int rightBars = input.int(2, "Pivot Right", minval=1, group=GRP_MTF)
int syncBars = input.int(2, "Max Pivot Distance (bars)", minval=0, group=GRP_MTF)
float rsiOB = input.float(70, "RSI Overbought", minval=50, maxval=100, group=GRP_MTF)
float rsiOS = input.float(30, "RSI Oversold", minval=0, maxval=50, group=GRP_MTF)
bool useOBOS = input.bool(false, "Require RSI Overbought/Oversold", group=GRP_MTF)
bool showSignals = input.bool(true, "Show MTF BUY/SELL Signals", group=GRP_MTF)

string GRP_DIV = "2. Divergence"
bool showRegularDiv = input.bool(true, "Show Regular Divergence", group=GRP_DIV)
bool showHiddenDiv = input.bool(false, "Show Hidden Divergence", group=GRP_DIV)

string GRP_VP = "3. Approximate Volume Profile"
bool showVP = input.bool(true, "Show Volume Profile", group=GRP_VP)
int vpLookback = input.int(150, "Lookback Bars", minval=30, maxval=400, group=GRP_VP)
int vpRows = input.int(24, "Profile Rows", minval=8, maxval=40, group=GRP_VP)
int vpWidth = input.int(18, "Maximum Profile Width (bars)", minval=5, maxval=40, group=GRP_VP)
float vaPercent = input.float(70, "Value Area %", minval=50, maxval=95, group=GRP_VP)

//====================================================
// 2. RSI + MFI ON CHART TIMEFRAME
//====================================================
float rsi = ta.rsi(close, rsiLen)
float mfi = ta.mfi(hlc3, mfiLen)

//====================================================
// 3. MTF SIGNAL ENGINE
// Runs inside each requested timeframe.
// Signals use the previous completed candle.
//====================================================
f_engine() =>
    float r = ta.rsi(close, rsiLen)
    float m = ta.mfi(hlc3, mfiLen)

    float rPL = ta.pivotlow(r, leftBars, rightBars)
    float rPH = ta.pivothigh(r, leftBars, rightBars)
    float mPL = ta.pivotlow(m, leftBars, rightBars)
    float mPH = ta.pivothigh(m, leftBars, rightBars)

    bool rLow = not na(rPL)
    bool rHigh = not na(rPH)
    bool mLow = not na(mPL)
    bool mHigh = not na(mPH)

    int rLowAge = ta.barssince(rLow)
    int rHighAge = ta.barssince(rHigh)
    int mLowAge = ta.barssince(mLow)
    int mHighAge = ta.barssince(mHigh)

    bool buy = (rLow and not na(mLowAge) and mLowAge <= syncBars) or (mLow and not na(rLowAge) and rLowAge <= syncBars)
    bool sell = (rHigh and not na(mHighAge) and mHighAge <= syncBars) or (mHigh and not na(rHighAge) and rHighAge <= syncBars)

    bool buyOBOS = not useOBOS or r[rightBars] <= rsiOS
    bool sellOBOS = not useOBOS or r[rightBars] >= rsiOB

    buy := buy and buyOBOS
    sell := sell and sellOBOS

    [buy[1], sell[1], r[1], m[1]]

//====================================================
// 4. REQUEST CONFIRMED MTF VALUES
//====================================================
[b1, s1, r1, m1] = request.security(syminfo.tickerid, "1", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[b5, s5, r5, m5] = request.security(syminfo.tickerid, "5", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[b15, s15, r15, m15] = request.security(syminfo.tickerid, "15", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[b30, s30, r30, m30] = request.security(syminfo.tickerid, "30", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[b60, s60, r60, m60] = request.security(syminfo.tickerid, "60", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[b240, s240, r240, m240] = request.security(syminfo.tickerid, "240", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[bD, sD, rD, mD] = request.security(syminfo.tickerid, "D", f_engine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

//====================================================
// 5. EDGE DETECTION: ONE LABEL PER SIGNAL CHANGE
//====================================================
bool buy1 = showSignals and b1 and not b1[1]
bool sell1 = showSignals and s1 and not s1[1]
bool buy5 = showSignals and b5 and not b5[1]
bool sell5 = showSignals and s5 and not s5[1]
bool buy15 = showSignals and b15 and not b15[1]
bool sell15 = showSignals and s15 and not s15[1]
bool buy30 = showSignals and b30 and not b30[1]
bool sell30 = showSignals and s30 and not s30[1]
bool buy60 = showSignals and b60 and not b60[1]
bool sell60 = showSignals and s60 and not s60[1]
bool buy240 = showSignals and b240 and not b240[1]
bool sell240 = showSignals and s240 and not s240[1]
bool buyD = showSignals and bD and not bD[1]
bool sellD = showSignals and sD and not sD[1]

//====================================================
// 6. PLOT MTF BUY / SELL
//====================================================
plotshape(buy1, title="BUY M1", style=shape.labelup, location=location.belowbar, color=color.lime, text="BUY 1", textcolor=color.black, size=size.tiny)
plotshape(sell1, title="SELL M1", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL 1", textcolor=color.white, size=size.tiny)

plotshape(buy5, title="BUY M5", style=shape.labelup, location=location.belowbar, color=color.lime, text="BUY 5", textcolor=color.black, size=size.tiny)
plotshape(sell5, title="SELL M5", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL 5", textcolor=color.white, size=size.tiny)

plotshape(buy15, title="BUY M15", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY 15", textcolor=color.white, size=size.tiny)
plotshape(sell15, title="SELL M15", style=shape.labeldown, location=location.abovebar, color=color.maroon, text="SELL 15", textcolor=color.white, size=size.tiny)

plotshape(buy30, title="BUY M30", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY 30", textcolor=color.white, size=size.tiny)
plotshape(sell30, title="SELL M30", style=shape.labeldown, location=location.abovebar, color=color.maroon, text="SELL 30", textcolor=color.white, size=size.tiny)

plotshape(buy60, title="BUY H1", style=shape.labelup, location=location.belowbar, color=color.teal, text="BUY H1", textcolor=color.white, size=size.tiny)
plotshape(sell60, title="SELL H1", style=shape.labeldown, location=location.abovebar, color=color.orange, text="SELL H1", textcolor=color.black, size=size.tiny)

plotshape(buy240, title="BUY H4", style=shape.labelup, location=location.belowbar, color=color.blue, text="BUY H4", textcolor=color.white, size=size.tiny)
plotshape(sell240, title="SELL H4", style=shape.labeldown, location=location.abovebar, color=color.purple, text="SELL H4", textcolor=color.white, size=size.tiny)

plotshape(buyD, title="BUY D", style=shape.labelup, location=location.belowbar, color=color.aqua, text="BUY D", textcolor=color.black, size=size.tiny)
plotshape(sellD, title="SELL D", style=shape.labeldown, location=location.abovebar, color=color.fuchsia, text="SELL D", textcolor=color.white, size=size.tiny)

//====================================================
// 7. RSI + MFI DIVERGENCE ON CHART TIMEFRAME
//====================================================
float pricePL = ta.pivotlow(low, leftBars, rightBars)
float pricePH = ta.pivothigh(high, leftBars, rightBars)

float prevLowPrice = ta.valuewhen(not na(pricePL), pricePL, 1)
float prevLowRSI = ta.valuewhen(not na(pricePL), rsi[rightBars], 1)
float prevLowMFI = ta.valuewhen(not na(pricePL), mfi[rightBars], 1)

float prevHighPrice = ta.valuewhen(not na(pricePH), pricePH, 1)
float prevHighRSI = ta.valuewhen(not na(pricePH), rsi[rightBars], 1)
float prevHighMFI = ta.valuewhen(not na(pricePH), mfi[rightBars], 1)

bool regularBull = not na(pricePL) and not na(prevLowPrice) and pricePL < prevLowPrice and rsi[rightBars] > prevLowRSI and mfi[rightBars] > prevLowMFI
bool regularBear = not na(pricePH) and not na(prevHighPrice) and pricePH > prevHighPrice and rsi[rightBars] < prevHighRSI and mfi[rightBars] < prevHighMFI

bool hiddenBull = not na(pricePL) and not na(prevLowPrice) and pricePL > prevLowPrice and rsi[rightBars] < prevLowRSI and mfi[rightBars] < prevLowMFI
bool hiddenBear = not na(pricePH) and not na(prevHighPrice) and pricePH < prevHighPrice and rsi[rightBars] > prevHighRSI and mfi[rightBars] > prevHighMFI

bool bullDiv = showRegularDiv and regularBull
bool bearDiv = showRegularDiv and regularBear
bool bullHidden = showHiddenDiv and hiddenBull
bool bearHidden = showHiddenDiv and hiddenBear

plotshape(bullDiv, title="Regular Bullish Divergence", style=shape.labelup, location=location.belowbar, offset=0, color=color.green, text="BULL DIV", textcolor=color.white, size=size.small)
plotshape(bearDiv, title="Regular Bearish Divergence", style=shape.labeldown, location=location.abovebar, offset=0, color=color.red, text="BEAR DIV", textcolor=color.white, size=size.small)
plotshape(bullHidden, title="Hidden Bullish Divergence", style=shape.labelup, location=location.belowbar, offset=0, color=color.teal, text="HIDDEN BULL", textcolor=color.white, size=size.tiny)
plotshape(bearHidden, title="Hidden Bearish Divergence", style=shape.labeldown, location=location.abovebar, offset=0, color=color.orange, text="HIDDEN BEAR", textcolor=color.black, size=size.tiny)

//====================================================
// 8. MTF DASHBOARD
//====================================================
var table dash = table.new(position.top_right, 4, 8, border_width=1)

f_signal_text(bool buySignal, bool sellSignal) =>
    buySignal ? "BUY" : sellSignal ? "SELL" : "WAIT"

f_signal_color(bool buySignal, bool sellSignal) =>
    buySignal ? color.new(color.green, 15) : sellSignal ? color.new(color.red, 15) : color.new(color.gray, 75)

if barstate.islast
    table.cell(dash, 0, 0, "TF", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "RSI", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 2, 0, "MFI", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 3, 0, "SIGNAL", bgcolor=color.black, text_color=color.white)

    table.cell(dash, 0, 1, "M1")
    table.cell(dash, 1, 1, str.tostring(r1, "#.0"))
    table.cell(dash, 2, 1, str.tostring(m1, "#.0"))
    table.cell(dash, 3, 1, f_signal_text(b1, s1), bgcolor=f_signal_color(b1, s1), text_color=color.white)

    table.cell(dash, 0, 2, "M5")
    table.cell(dash, 1, 2, str.tostring(r5, "#.0"))
    table.cell(dash, 2, 2, str.tostring(m5, "#.0"))
    table.cell(dash, 3, 2, f_signal_text(b5, s5), bgcolor=f_signal_color(b5, s5), text_color=color.white)

    table.cell(dash, 0, 3, "M15")
    table.cell(dash, 1, 3, str.tostring(r15, "#.0"))
    table.cell(dash, 2, 3, str.tostring(m15, "#.0"))
    table.cell(dash, 3, 3, f_signal_text(b15, s15), bgcolor=f_signal_color(b15, s15), text_color=color.white)

    table.cell(dash, 0, 4, "M30")
    table.cell(dash, 1, 4, str.tostring(r30, "#.0"))
    table.cell(dash, 2, 4, str.tostring(m30, "#.0"))
    table.cell(dash, 3, 4, f_signal_text(b30, s30), bgcolor=f_signal_color(b30, s30), text_color=color.white)

    table.cell(dash, 0, 5, "H1")
    table.cell(dash, 1, 5, str.tostring(r60, "#.0"))
    table.cell(dash, 2, 5, str.tostring(m60, "#.0"))
    table.cell(dash, 3, 5, f_signal_text(b60, s60), bgcolor=f_signal_color(b60, s60), text_color=color.white)

    table.cell(dash, 0, 6, "H4")
    table.cell(dash, 1, 6, str.tostring(r240, "#.0"))
    table.cell(dash, 2, 6, str.tostring(m240, "#.0"))
    table.cell(dash, 3, 6, f_signal_text(b240, s240), bgcolor=f_signal_color(b240, s240), text_color=color.white)

    table.cell(dash, 0, 7, "D")
    table.cell(dash, 1, 7, str.tostring(rD, "#.0"))
    table.cell(dash, 2, 7, str.tostring(mD, "#.0"))
    table.cell(dash, 3, 7, f_signal_text(bD, sD), bgcolor=f_signal_color(bD, sD), text_color=color.white)

//====================================================
// 9. APPROXIMATE VOLUME PROFILE
// Each candle's volume is assigned to the HLC3 price bin.
// This is NOT true volume-at-price data.
//====================================================
float vpRangeLow = ta.lowest(low, vpLookback)
float vpRangeHigh = ta.highest(high, vpLookback)

var array<box> vpBoxes = array.new_box()
var line pocLine = na
var line vahLine = na
var line valLine = na
var label pocLabel = na
var label vahLabel = na
var label valLabel = na

if barstate.islast and showVP and bar_index >= vpLookback and vpRangeHigh > vpRangeLow
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
    array.clear(vpBoxes)

    if not na(pocLine)
        line.delete(pocLine)
    if not na(vahLine)
        line.delete(vahLine)
    if not na(valLine)
        line.delete(valLine)
    if not na(pocLabel)
        label.delete(pocLabel)
    if not na(vahLabel)
        label.delete(vahLabel)
    if not na(valLabel)
        label.delete(valLabel)

    float rowHeight = (vpRangeHigh - vpRangeLow) / vpRows
    array<float> rowVolumes = array.new_float(vpRows, 0.0)

    for i = 0 to vpLookback - 1
        int binIndex = int(math.floor((hlc3[i] - vpRangeLow) / rowHeight))
        binIndex := math.max(0, math.min(vpRows - 1, binIndex))
        array.set(rowVolumes, binIndex, array.get(rowVolumes, binIndex) + nz(volume[i], 0.0))

    float maxRowVol = 0.0
    float totalVol = 0.0
    int pocIndex = 0

    for i = 0 to vpRows - 1
        float thisVol = array.get(rowVolumes, i)
        totalVol += thisVol
        if thisVol > maxRowVol
            maxRowVol := thisVol
            pocIndex := i

    int vaLowIndex = pocIndex
    int vaHighIndex = pocIndex
    float vaAccum = array.get(rowVolumes, pocIndex)
    float vaTarget = totalVol * vaPercent / 100.0

    for i = 0 to vpRows - 1
        if vaAccum < vaTarget
            float nextBelow = vaLowIndex > 0 ? array.get(rowVolumes, vaLowIndex - 1) : -1.0
            float nextAbove = vaHighIndex < vpRows - 1 ? array.get(rowVolumes, vaHighIndex + 1) : -1.0
            if nextAbove >= nextBelow and vaHighIndex < vpRows - 1
                vaHighIndex += 1
                vaAccum += array.get(rowVolumes, vaHighIndex)
            else if vaLowIndex > 0
                vaLowIndex -= 1
                vaAccum += array.get(rowVolumes, vaLowIndex)

    for i = 0 to vpRows - 1
        float thisVol = array.get(rowVolumes, i)
        int rowWidth = maxRowVol > 0 ? math.max(1, int(math.round(thisVol / maxRowVol * vpWidth))) : 1
        float yBottom = vpRangeLow + i * rowHeight
        float yTop = yBottom + rowHeight
        color rowColor = i == pocIndex ? color.yellow : (i >= vaLowIndex and i <= vaHighIndex ? color.new(color.teal, 35) : color.new(color.gray, 70))
        box bx = box.new(left=bar_index + 2, top=yTop, right=bar_index + 2 + rowWidth, bottom=yBottom, xloc=xloc.bar_index, bgcolor=rowColor, border_color=color.new(rowColor, 100))
        array.push(vpBoxes, bx)

    float pocPrice = vpRangeLow + (pocIndex + 0.5) * rowHeight
    float vahPrice = vpRangeLow + (vaHighIndex + 1.0) * rowHeight
    float valPrice = vpRangeLow + vaLowIndex * rowHeight

    pocLine := line.new(bar_index - vpLookback + 1, pocPrice, bar_index + vpWidth + 3, pocPrice, xloc=xloc.bar_index, color=color.yellow, width=2)
    vahLine := line.new(bar_index - vpLookback + 1, vahPrice, bar_index + vpWidth + 3, vahPrice, xloc=xloc.bar_index, color=color.green, width=1)
    valLine := line.new(bar_index - vpLookback + 1, valPrice, bar_index + vpWidth + 3, valPrice, xloc=xloc.bar_index, color=color.red, width=1)

    pocLabel := label.new(bar_index + vpWidth + 4, pocPrice, "POC", xloc=xloc.bar_index, style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
    vahLabel := label.new(bar_index + vpWidth + 4, vahPrice, "VAH", xloc=xloc.bar_index, style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)
    valLabel := label.new(bar_index + vpWidth + 4, valPrice, "VAL", xloc=xloc.bar_index, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)

//====================================================
// 10. ALERT CONDITIONS
//====================================================
bool anyBuy = buy1 or buy5 or buy15 or buy30 or buy60 or buy240 or buyD
bool anySell = sell1 or sell5 or sell15 or sell30 or sell60 or sell240 or sellD

alertcondition(anyBuy, title="MTF BUY", message="RSI + MFI MTF BUY signal on {{ticker}}")
alertcondition(anySell, title="MTF SELL", message="RSI + MFI MTF SELL signal on {{ticker}}")
alertcondition(bullDiv, title="Regular Bullish Divergence", message="Regular bullish RSI + MFI divergence on {{ticker}}")
alertcondition(bearDiv, title="Regular Bearish Divergence", message="Regular bearish RSI + MFI divergence on {{ticker}}")
alertcondition(bullHidden, title="Hidden Bullish Divergence", message="Hidden bullish RSI + MFI divergence on {{ticker}}")
alertcondition(bearHidden, title="Hidden Bearish Divergence", message="Hidden bearish RSI + MFI divergence on {{ticker}}")
